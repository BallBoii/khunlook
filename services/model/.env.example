# Copy to .env (git-ignored) and run: docker run --env-file services/model/.env ...

OPENROUTER_API_KEY=

# EMBED_MODEL must be the model that built the vector-db index.
# EMBED_MODEL=baai/bge-m3
# Every returned vector is checked against EMBED_DIM (0 = don't check).
# EMBED_DIM=1024
# CHAT_MODEL=google/gemma-3-4b-it
# Keep below rag's EMBED_TIMEOUT_S (10) and CHAT_TIMEOUT_S (60).
# EMBED_TIMEOUT_S=8
# CHAT_TIMEOUT_S=55
# MAX_RETRIES=2
# Simultaneous OpenRouter calls per pod.
# MAX_CONCURRENCY=8
# MAX_TOKENS_CAP=1024
# LOG_LEVEL=info
