# Generated by Ansible (roles/master). Used once by `kubeadm init`.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ ansible_host }}
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ kubeadm_version.stdout }}
controlPlaneEndpoint: {{ ansible_host }}:6443
apiServer:
  certSANs:
    - {{ ansible_host }}
    - {{ inventory_hostname }}
networking:
  podSubnet: {{ pod_cidr }}
controllerManager:
  extraArgs:
    - name: node-monitor-grace-period
      value: "{{ node_monitor_grace_period }}"
---
# Shared by every kubelet that joins (kubeadm stores it in the kubelet-config ConfigMap).
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
nodeStatusUpdateFrequency: {{ node_status_update_frequency }}
# Swap is turned off by the common role; this only stops kubelet refusing to start if an image
# re-enables it (e.g. zram on newer Raspberry Pi OS). Pods still never use swap.
failSwapOn: false
memorySwap:
  swapBehavior: NoSwap
