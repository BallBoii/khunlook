# Rendered by roles/argocd and piped into `kubectl apply -f -`; never written to the repo.
apiVersion: v1
kind: Secret
metadata:
  name: openrouter
  namespace: {{ app_namespace }}
type: Opaque
stringData:
  api-key: {{ vault_openrouter_api_key | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: khunlook-repo
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: {{ app_repo_url | to_json }}
  sshPrivateKey: {{ vault_argocd_repo_ssh_key | to_json }}
{% if vault_ghcr_pull_token | default('') | length > 0 %}
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: {{ app_namespace }}
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: {{ {'auths': {'ghcr.io': {'auth': (vault_ghcr_pull_user ~ ':' ~ vault_ghcr_pull_token) | b64encode}}} | to_json | to_json }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: default
  namespace: {{ app_namespace }}
imagePullSecrets:
  - name: ghcr-pull
{% endif %}
